# CivicConnect Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/civicconnect

# JWT
JWT_SECRET=your_very_long_random_jwt_secret_here_change_me
JWT_EXPIRES_IN=7d

# Admin Seed Credentials (used by seed script only)
ADMIN_EMAIL=admin@civicconnect.com
ADMIN_PASSWORD=Admin@2024!
ADMIN_NAME=System Administrator

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# AI Service (optional)
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@civicconnect.com
